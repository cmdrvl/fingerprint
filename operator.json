{
  "schema_version": "operator.v0",
  "name": "fingerprint",
  "version": "0.11.0",
  "description": "Tests artifacts against fingerprint definitions and produces content hashes. Spreadsheet fingerprints use the xlsx assertion surface for .xlsx and legacy .xls workbooks; csv fingerprints can also evaluate delimited text-extension records.",
  "repository": "https://github.com/cmdrvl/fingerprint",
  "license": "MIT",
  "agent_guide": "https://github.com/cmdrvl/.github/blob/main/profile/AGENT_PROMPT.md",

  "invocation": {
    "binary": "fingerprint",
    "output_mode": "stream",
    "output_schema": "fingerprint.v0",
    "json_flag": "--json"
  },

  "arguments": [
    { "name": "input", "type": "file_path", "required": false, "position": 0, "description": "JSONL manifest file (default: stdin)" }
  ],

  "options": [
    { "name": "json", "flag": "--json", "type": "boolean", "description": "Accepted as structured-output intent; run-mode output is already JSONL" },
    { "name": "robot_triage", "flag": "--robot-triage", "type": "boolean", "description": "Emit one machine-readable triage report without reading input" },
    { "name": "fp", "flag": "--fp", "alias": "--fingerprint", "type": "string", "repeatable": true, "description": "Fingerprint ID (evaluated in CLI order; first match wins)" },
    { "name": "list", "flag": "--list", "type": "boolean", "description": "List available fingerprints" },
    { "name": "jobs", "flag": "--jobs", "type": "integer", "description": "Number of parallel workers" },
    { "name": "no_witness", "flag": "--no-witness", "type": "boolean", "description": "Suppress witness ledger recording" },
    { "name": "progress", "flag": "--progress", "type": "boolean", "description": "Emit structured progress on stderr" },
    { "name": "diagnose", "flag": "--diagnose", "type": "boolean", "description": "Include assertion failure context and evaluate all assertions" },
    { "name": "describe", "flag": "--describe", "type": "boolean", "description": "Print operator manifest and exit" },
    { "name": "schema", "flag": "--schema", "type": "boolean", "description": "Print output schema and exit" }
  ],

  "subcommands": [
    {
      "name": "capabilities",
      "usage": "fingerprint capabilities --json",
      "description": "Return machine-readable tool capabilities without reading stdin or appending witness records.",
      "current_runtime_behavior": {
        "read_only": true,
        "network": "not_used",
        "writes_witness": false,
        "writes_definitions": false,
        "writes_artifacts": false
      },
      "commands": [
        { "usage": "fingerprint capabilities --json", "output": "json", "mutates": false }
      ]
    },
    {
      "name": "robot-docs",
      "usage": "fingerprint robot-docs guide",
      "description": "Print paste-ready operating notes for agents.",
      "current_runtime_behavior": {
        "read_only": true,
        "network": "not_used",
        "writes_witness": false,
        "writes_definitions": false,
        "writes_artifacts": false
      },
      "commands": [
        { "usage": "fingerprint robot-docs guide", "output": "markdown", "mutates": false }
      ]
    },
    {
      "name": "peek",
      "usage": "fingerprint peek <FILE> [--rows N] [--json] [--suggest] [--no-witness]",
      "description": "Inspect CSV-like row shape without emitting cell content.",
      "current_runtime_behavior": {
        "read_only": true,
        "emits_cell_content": false,
        "writes_witness": "unless --no-witness",
        "writes_artifacts": false
      },
      "commands": [
        { "usage": "fingerprint peek data.csv --json --suggest", "output": "json", "mutates": false },
        { "usage": "fingerprint peek data.csv --rows 25 --no-witness", "output": "json", "mutates": false }
      ]
    },
    {
      "name": "doctor",
      "usage": "fingerprint doctor <health|capabilities|robot-docs> [--robot-triage] [--fix]",
      "description": "Read-only diagnostics and machine-readable health/capability reporting for agents.",
      "current_runtime_behavior": {
        "read_only": true,
        "fix_mode": "not_available",
        "network": "not_used",
        "writes_witness": false,
        "writes_definitions": false,
        "writes_artifacts": false
      },
      "commands": [
        { "usage": "fingerprint doctor health", "output": "one-line text", "mutates": false },
        { "usage": "fingerprint doctor health --json", "output": "json", "mutates": false },
        { "usage": "fingerprint doctor capabilities --json", "output": "json", "mutates": false },
        { "usage": "fingerprint doctor robot-docs", "output": "markdown", "mutates": false },
        { "usage": "fingerprint doctor --robot-triage", "output": "json", "mutates": false },
        { "usage": "fingerprint doctor --fix", "output": "stderr text and exit 2", "mutates": false }
      ]
    }
  ],

  "exit_codes": {
    "0": { "meaning": "ALL_MATCHED", "domain": "positive" },
    "1": { "meaning": "PARTIAL", "domain": "negative" },
    "2": { "meaning": "REFUSAL", "domain": "error" }
  },

  "refusals": [
    { "code": "E_BAD_INPUT", "message": "Invalid JSONL or missing hash fields", "action": "run_upstream", "tool": "hash" },
    { "code": "E_UNKNOWN_FP", "message": "Fingerprint ID not found", "action": "escalate" },
    { "code": "E_DUPLICATE_FP_ID", "message": "Duplicate fingerprint ID across providers", "action": "escalate" },
    { "code": "E_UNTRUSTED_FP", "message": "Fingerprint provider not allowlisted", "action": "escalate" },
    { "code": "E_ORPHAN_CHILD", "message": "Child record references unknown parent", "action": "escalate" },
    { "code": "E_INVALID_YAML", "message": "Fingerprint definition YAML parse error or schema violation", "action": "escalate" },
    { "code": "E_UNKNOWN_ASSERTION", "message": "Assertion type not recognized in fingerprint definition", "action": "escalate" },
    { "code": "E_MISSING_FIELD", "message": "Required field missing from fingerprint definition", "action": "escalate" },
    { "code": "E_INVALID_SELECTOR", "message": "CSS selector is malformed in a fingerprint definition", "action": "fix_definition" },
    { "code": "E_PARSE", "message": "Cannot parse document content (warning, non-fatal)", "action": "escalate" }
  ],

  "capabilities": {
    "formats": ["csv", "xlsx", "pdf", "html", "markdown", "text"],
    "profile_aware": false,
    "streaming": true,
    "row_shape_peek": true,
    "veil_safe_shape_sensor": true,
    "agent_surfaces": [
      "fingerprint --robot-triage",
      "fingerprint capabilities --json",
      "fingerprint robot-docs guide"
    ]
  },

  "pipeline": {
    "upstream": ["hash"],
    "downstream": ["lock"]
  }
}
